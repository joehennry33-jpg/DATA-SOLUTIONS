# =============================================================================
# SafBundle Environment Variables Template
# Copy this file to .env.local (Next.js/Local) or .env and fill real values.
# NEVER commit real secrets to source control.
# =============================================================================

# Runtime Application URL (used for Daraja callbacks and self-referential links)
APP_URL="http://localhost:3000"

# Gemini API (optional in AI Studio runtime)
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# Safaricom Daraja M-Pesa API Credentials (Server-Side Only — Never expose to client)
# Set DARAJA_ENV to "sandbox" or "production"
# -----------------------------------------------------------------------------
DARAJA_ENV="sandbox"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
DARAJA_CALLBACK_URL=""
DARAJA_C2B_CONFIRMATION_URL=""
DARAJA_C2B_VALIDATION_URL=""
# Optional shared secret token appended as ?token=... or X-Daraja-Webhook-Secret header
DARAJA_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Authorized Bundle Supplier API Credentials (Server-Side Only)
# -----------------------------------------------------------------------------
SUPPLIER_API_URL=""
SUPPLIER_API_KEY=""
SUPPLIER_PARTNER_ID=""
SUPPLIER_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Administrator Access Control (comma-separated verified Google emails)
# -----------------------------------------------------------------------------
ADMIN_EMAILS=""

# -----------------------------------------------------------------------------
# Firebase Admin SDK (Optional for Vercel / external Node deployments)
# Paste single-line JSON of a Firebase service account key to persist directly to Firestore.
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=""

# -----------------------------------------------------------------------------
# Supabase PostgreSQL (For Vercel + Supabase deployment — see supabase/schema.sql)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
